# 复制为 .env 后填写。程序读取环境变量,其次读取本目录 .env;不会回写。
# 不要把参考项目的 .env 复制过来。

# DeepSeek(官方接口)。模型 ID 不设默认值:先用 `python -m app.cli models` 核对可用模型再填写。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_JSON_MODE=1
# DEEPSEEK_TIMEOUT=180
# DEEPSEEK_MAX_RETRIES=2
# DEEPSEEK_MAX_TOKENS=4000

# 关注列表(首次启动写入数据库,之后以数据库为准,用 watch 命令或页面修改)
# RT_WATCHLIST=BTC-USDT-SWAP,ETH-USDT-SWAP

# 1D/1W 开盘口径:utc8 = OKX 默认(UTC+8 开盘的 1D/1W);utc = 整体切换为 1Dutc/1Wutc
# RT_DAILY_BAR_MODE=utc8

# 调度
# RT_HOURLY_DELAY_SEC=90
# RT_DAILY_TIME=09:10
# RT_SCHEDULE_TZ=America/Los_Angeles
# RT_DISPLAY_TZ=Asia/Shanghai

# 风控假设(单边费率;净盈亏比按入场+出场双边成本计算)
# RT_MIN_NET_RR=2.0
# RT_FEE_RATE=0.0005
# RT_SLIPPAGE_RATE=0.0005

# 社区采集
# RT_COMMUNITY_MAX_PAGES=60
# RT_COMMUNITY_MAX_DETAILS=300
# RT_COMMUNITY_MIN_POSTS=10
# RT_COMMUNITY_MIN_AUTHORS=5
# RT_COMMUNITY_WINDOW_HOURS=24
# RT_COMMUNITY_EXPIRE_HOURS=26

# 存储与 Web
# RT_DB_PATH=var/righttrend.db
# RT_WEB_PORT=8430
